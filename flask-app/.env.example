# Flask/Dream11 Prediction App - Example Environment Variables

# Flask secret key (used for sessions and JWT in API routes)
SECRET_KEY=change-this-in-production

# Optional: Override DB URI (default points to instance/dream11_prediction.db)
# Example for Postgres: postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL=

# Flask runtime flags
FLASK_ENV=development
FLASK_DEBUG=True

# If you plan to run Flask CLI commands (migrations), set the app module
FLASK_APP=app.py
